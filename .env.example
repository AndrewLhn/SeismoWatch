# Copy this file to .env. Do not commit .env. Compose requires every value
# (`:?` interpolation fails fast when a variable is missing).

# Dev-only Fernet key so a fresh clone boots. Generate your own before the
# stack is shared:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=MoseVSjiiOxLstzUe4YYNYbJ2yLTwJob56siMyS48eA=

# Analytics database (PostGIS)
POSTGRES_USER=seismic
POSTGRES_PASSWORD=change-me
POSTGRES_DB=seismic

# S3-compatible object store (Silo, a MinIO-compatible fork)
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-minio
SEISMIC_BUCKET=seismic-raw

# Source
USGS_BASE_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
SEISMIC_H3_RESOLUTION=5
